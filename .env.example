# =============================================================================
# VARIABLES D'ENVIRONNEMENT — modèle (aucune vraie valeur ici)
# Chaque service a sa propre liste. Une variable « NEXT_PUBLIC_ » est VISIBLE
# par tout le monde dans le navigateur : n'y mettez jamais de secret.
# =============================================================================

# -----------------------------------------------------------------------------
# 1-FRONTEND (client, vendeur, administrateur) → Vercel, un projet par application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx   # clé publique : protégée par la RLS
NEXT_PUBLIC_API_URL=https://api.votre-domaine.ci
NEXT_PUBLIC_SITE_URL=https://www.votre-domaine.ci              # adapter par application

# -----------------------------------------------------------------------------
# 2-BACKEND/api → Render (tableau de bord Render, onglet « Environment »)
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
ALLOWED_ORIGINS=https://www.votre-domaine.ci,https://pro.votre-domaine.ci,https://admin.votre-domaine.ci

API_PUBLIC_URL=https://api.votre-domaine.ci
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx  # appels « au nom de l'utilisateur » (RLS)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx          # ⚠ contourne la RLS : uniquement ici
SUPABASE_JWKS_URL=https://xxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json

CRON_SECRET=                                    # même valeur que le secret « render_cron_secret » du coffre Supabase

# Paiement : 'simulation' (tests, page /paiement-test) ou 'jeko' (API réelle)
PAIEMENT_MODE=simulation
# La simulation en production exige ce drapeau explicite — à retirer au branchement Jeko
AUTORISER_PAIEMENT_SIMULATION=false
PAIEMENT_SIMULATION_SECRET=                    # 16 caractères min, signe les webhooks de test

# Jeko (obligatoires seulement si PAIEMENT_MODE=jeko — à compléter avec leur documentation)
JEKO_API_URL=https://api.jeko.africa
JEKO_API_KEY=
JEKO_WEBHOOK_SECRET=
JEKO_RETURN_URL=https://www.votre-domaine.ci/paiement/retour

# Facture normalisée électronique (DGI)
FNE_API_URL=
FNE_API_KEY=

# Vérification d'identité (fournisseur KYC retenu)
KYC_PROVIDER=
KYC_API_KEY=
KYC_WEBHOOK_SECRET=

# Agents IA
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_DEFAULT_MODEL=claude-haiku-5-5
LLM_PRIX_ENTREE_USD_PAR_MTOK=                   # tarifs publiés du modèle choisi : nécessaires au budget quotidien
LLM_PRIX_SORTIE_USD_PAR_MTOK=

# Messages (API HTTP : les ports SMTP sont bloqués sur Render gratuit)
EMAIL_API_KEY=
EMAIL_FROM="Plateforme <no-reply@votre-domaine.ci>"
SMS_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Surveillance
SENTRY_DSN=
LOG_LEVEL=info

# Chiffrement applicatif des données de versement (32 octets en base64)
PAYOUT_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# GitHub Actions (Settings → Secrets) — sauvegarde nocturne
# -----------------------------------------------------------------------------
# SUPABASE_DB_URL=postgresql://...      (chaîne de connexion directe, rôle en lecture)
# BACKUP_PASSPHRASE=                    (phrase longue, gardée aussi hors ligne)

# =============================================================================
# Secrets lus par supabase/config.toml avec env(NOM_VARIABLE)
#
# 1. Copier ce fichier :   cp supabase/.env.example supabase/.env
# 2. Remplir les valeurs dont vous avez besoin (laisser vide sinon)
# 3. Ne JAMAIS commiter supabase/.env (il est dans supabase/.gitignore)
#
# Ces variables servent uniquement à la pile LOCALE. En production, les mêmes
# réglages se font dans le tableau de bord Supabase (Authentication → Providers).
# =============================================================================

# Connexion Google — console.cloud.google.com → API et services → Identifiants
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Connexion Apple — developer.apple.com (compte Apple Developer payant requis)
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Envoi réel des emails (optionnel en local : la boîte de test suffit)
SUPABASE_AUTH_SMTP_PASSWORD=

# SMS via Twilio (désactivé par défaut)
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# Captcha Cloudflare Turnstile (optionnel en local)
SUPABASE_AUTH_CAPTCHA_SECRET=

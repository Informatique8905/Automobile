# Application « client » — à saisir dans Vercel (Settings → Environment Variables)
# Uniquement des valeurs PUBLIQUES : tout ce qui commence par NEXT_PUBLIC_ est visible dans le navigateur.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mettre "true" pour afficher les boutons Google / Apple (après configuration OAuth dans Supabase)
NEXT_PUBLIC_SSO_ACTIVE=false
